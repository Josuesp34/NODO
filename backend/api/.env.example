# Solo desarrollo. Copiar a .env y establecer una contraseña local.
# El archivo .env no se versiona (lo bloquean .gitignore y pre-commit).

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=nodo_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nodo_db
# Si cambian usuario/contraseña/base, actualizar también estas URLs.
# Codificar caracteres reservados de la contraseña en la URL.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://nodo_dev:change-me-local-only@localhost:5433/nodo_db
DOCKER_DATABASE_URL=postgresql+asyncpg://nodo_dev:change-me-local-only@timescaledb:5432/nodo_db

# --- API ---------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Límite de lectura del archivo FIT. No sustituye el límite de cuerpo del proxy.
MAX_FIT_BYTES=10485760

# --- Sesiones ----------------------------------------------------------------
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# --- Bootstrap local ---------------------------------------------------------
# Activar solo para el bootstrap local de un entrenador; mantener false en entornos compartidos.
ALLOW_COACH_REGISTRATION=false
# Sólo desarrollo: definir una clave secreta local y usarla como header
# X-NODO-Development-Key al crear el primer superusuario.
ALLOW_SUPERUSER_BOOTSTRAP=false
DEV_SUPERUSER_BOOTSTRAP_TOKEN=

# =============================================================================
# Variables previstas por docs/PLAN_EJECUCION.md.
# TODAVÍA NO LAS LEE EL CÓDIGO: quedan aquí para que cada fase sepa qué tendrá
# que configurar y para que nadie improvise un nombre distinto al llegar.
# Cada fase que implemente una variable debe moverla a la sección que le toque.
# =============================================================================

# --- F5 · Cola de trabajos sobre Postgres (ADR 0006) -------------------------
# WORKER_POLL_INTERVAL_SECONDS=5
# WORKER_BATCH_SIZE=10
# JOB_MAX_ATTEMPTS=5
# JOB_BACKOFF_BASE_SECONDS=30

# --- F6 · Conector intervals.icu (ADR 0005) ----------------------------------
# Compuerta humana: registrar la app OAuth y entregar credenciales por un canal
# seguro. Nunca escribir valores reales en este archivo.
# INTERVALS_CLIENT_ID=
# INTERVALS_CLIENT_SECRET=
# INTERVALS_REDIRECT_URI=http://localhost:8000/api/v1/connections/intervals/callback
# INTERVALS_WEBHOOK_SECRET=
# INTERVALS_BACKFILL_DAYS=90
# Escritura de sesiones planificadas al calendario de intervals: apagada por
# defecto. NODO es la fuente de verdad del plan.
# INTERVALS_PUSH_WORKOUTS=false
# Clave de cifrado en reposo de los tokens de proveedor. Generar por entorno,
# jamás en Git y jamás compartida entre entornos.
# PROVIDER_TOKEN_ENCRYPTION_KEY=

# --- F9 · Copiloto de planificación -------------------------------------------
# Compuerta humana: elegir proveedor, cuenta y tope de gasto mensual.
# `simulated` no sale a la red y es el modo con el que corre la suite.
# AI_PROVIDER=simulated
# AI_API_KEY=
# AI_MODEL=
# AI_MONTHLY_BUDGET_USD=0

# --- F12 · Operación y piloto -------------------------------------------------
# Compuerta humana: contratar hosting y correo transaccional.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# PUBLIC_APP_URL=http://localhost:3000
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# DATA_RETENTION_DAYS=
