# Solo desarrollo. Copiar a .env y establecer una contraseña local.
POSTGRES_USER=saas_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=saas_db
# Si cambian usuario/contraseña/base, actualizar también esta URL.
# Codificar caracteres reservados de la contraseña en la URL.
DATABASE_URL=postgresql+asyncpg://saas_dev:change-me-local-only@localhost:5432/saas_db
DOCKER_DATABASE_URL=postgresql+asyncpg://saas_dev:change-me-local-only@timescaledb:5432/saas_db
ENVIRONMENT=development
