# Solo desarrollo. Copiar a .env y establecer una contraseña local.
POSTGRES_USER=NODO_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=NODO_db
# Si cambian usuario/contraseña/base, actualizar también esta URL.
# Codificar caracteres reservados de la contraseña en la URL.
DATABASE_URL=postgresql+asyncpg://NODO_dev:change-me-local-only@localhost:5432/NODO_db
DOCKER_DATABASE_URL=postgresql+asyncpg://NODO_dev:change-me-local-only@timescaledb:5432/NODO_db
ENVIRONMENT=development
# Activar solo para el bootstrap local de un entrenador; mantener false en entornos compartidos.
ALLOW_COACH_REGISTRATION=false
