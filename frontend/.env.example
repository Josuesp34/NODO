# NODO Lab (navegador): API local expuesta por Docker.
NEXT_PUBLIC_NODO_API_URL=http://localhost:8000/api/v1

# NODO (Expo): sustituir localhost por la IP LAN del equipo al probar en un teléfono.
EXPO_PUBLIC_NODO_API_URL=http://localhost:8000/api/v1

# =============================================================================
# Variables previstas por docs/PLAN_EJECUCION.md para la PWA única (F2).
# TODAVÍA NO LAS LEE NINGUNA APP. La sesión pasa a vivir en una cookie httpOnly
# emitida por route handlers de Next (ADR 0004): el token deja de tocar el
# JavaScript del navegador, así que estas variables son del servidor de Next y
# no llevan el prefijo NEXT_PUBLIC_.
# =============================================================================
# NODO_API_URL=http://localhost:8000/api/v1
# SESSION_COOKIE_NAME=nodo_session
# SESSION_COOKIE_SECURE=false
