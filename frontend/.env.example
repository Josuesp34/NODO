# NODO Lab (navegador): API local expuesta por Docker.
NEXT_PUBLIC_NODO_API_URL=http://localhost:8000/api/v1

# NODO (Expo): sustituir localhost por la IP LAN del equipo al probar en un teléfono.
EXPO_PUBLIC_NODO_API_URL=http://localhost:8000/api/v1

# PWA NODO (servidor Next). Ninguna de estas variables se expone al navegador.
NODO_API_URL=http://localhost:8000/api/v1
SESSION_COOKIE_NAME=nodo_session
SESSION_COOKIE_SECURE=false
# Excepción HTTP únicamente para demo loopback explícita; producción siempre usa HTTPS.
NODO_LOCAL_DEMO=false
NODO_CONTACT_URL=

# Sólo Cloud Run: URL raíz del servicio API privado; Terraform la configura.
# NODO_CLOUD_RUN_AUDIENCE=https://API_APROBADA.run.app

# Cloud Run: origen HTTPS canónico de esta PWA para escrituras BFF.
# NODO_APP_ORIGIN=https://PWA_APROBADA.run.app
# Límites por cuerpo: sesión 16 KiB, JSON 1 MiB, archivo FIT 10 MiB.
NODO_BFF_SESSION_MAX_BYTES=16384
NODO_BFF_JSON_MAX_BYTES=1048576
NODO_BFF_FIT_MAX_BYTES=10485760
