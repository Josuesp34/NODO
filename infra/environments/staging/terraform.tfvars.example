# Copiar a terraform.tfvars fuera de control de versiones y reemplazar todos los valores.
# Ninguno de estos textos representa un ID, una región, un precio o una credencial reales.
project_id         = "REPLACE_WITH_STAGING_PROJECT_ID"
region             = "REPLACE_WITH_APPROVED_GCP_REGION"
database_tier      = "REPLACE_WITH_APPROVED_CLOUD_SQL_TIER"
bucket_name_prefix = "REPLACE_WITH_GLOBALLY_UNIQUE_PREFIX"
github_repository  = "REPLACE_WITH_OWNER/REPOSITORY"

# La primera aplicación crea únicamente la base de plataforma.
deploy_workloads         = false
enable_worker            = false
enable_monitoring_alerts = false

# Definir sólo después de aprobación financiera y configuración de canales.
# billing_account_id                  = "REPLACE_WITH_BILLING_ACCOUNT_ID"
# monthly_budget_units                = 0
# monitoring_notification_channel_ids = ["REPLACE_WITH_CHANNEL_RESOURCE_NAME"]

# Segunda aplicación: usar referencias inmutables y versiones explícitas de secretos.
# api_image = "REGION-docker.pkg.dev/PROJECT/REPOSITORY/api@sha256:REPLACE_64_HEX"
# pwa_image = "REGION-docker.pkg.dev/PROJECT/REPOSITORY/pwa@sha256:REPLACE_64_HEX"
