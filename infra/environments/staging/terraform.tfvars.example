#   RESEND_API_KEY = { secret_id = "resend-api-key", version = "REPLACE_WITH_VERSION" }
#   EMAIL_QUEUE_KEY = { secret_id = "email-queue-key", version = "REPLACE_WITH_VERSION" }
# }
# worker_secret_bindings = {
#   DATABASE_URL = { secret_id = "database-url", version = "REPLACE_WITH_VERSION" }
#   RESEND_API_KEY = { secret_id = "resend-api-key", version = "REPLACE_WITH_VERSION" }
#   EMAIL_QUEUE_KEY = { secret_id = "email-queue-key", version = "REPLACE_WITH_VERSION" }
# }
# api_env = { RESEND_FROM_EMAIL = "NODO <acceso@DOMINIO_VERIFICADO>", PUBLIC_APP_URL = "https://STAGING_DOMINIO" }
# worker_env = { RESEND_FROM_EMAIL = "NODO <acceso@DOMINIO_VERIFICADO>", PUBLIC_APP_URL = "https://STAGING_DOMINIO" }

# Antes de promover a otro proyecto, conceder lectura al deployer y service agent de prod.
# artifact_reader_members = [
#   "serviceAccount:nodo-prod-deploy@PROD_PROJECT_ID.iam.gserviceaccount.com",
#   "serviceAccount:service-PROD_PROJECT_NUMBER@serverless-robot-prod.iam.gserviceaccount.com",
# ]

# Proveedores desactivados hasta configurar cuentas/consentimientos y pruebas reales.
public_app_url   = "" # https://ORIGEN_PWA_APROBADO, sin slash final
# NODO_APP_ORIGIN y callback OAuth se derivan de ese origen; API permanece privada.
enable_intervals = false
enable_web_push  = false
enable_vertex_ai = false
